{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "script/v1",
  "title": "01_script.json — 稿子（Gemini 产出，人审批）",
  "type": "object",
  "required": ["schema", "episode_id", "title", "language", "chapters", "segments", "sources"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "script/v1" },
    "episode_id": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
    "title": { "type": "string", "minLength": 1 },
    "language": { "enum": ["en", "zh"] },
    "chapters": {
      "description": "章节：画面上的章节卡、BGM 换段都以章节为单位",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "title", "mood"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^c[0-9]{2}$" },
          "title": { "type": "string" },
          "mood": { "description": "取自 channel/bible.md 的情绪词表，用来选 BGM 和配色变体", "type": "string" }
        }
      }
    },
    "segments": {
      "description": "配音单位（一段 = 一次 TTS 调用，通常一个自然段，建议 15–60 秒）",
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "required": ["id", "chapter", "sentences"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^p[0-9]{3}$" },
          "chapter": { "type": "string", "pattern": "^c[0-9]{2}$" },
          "gap_after": { "description": "这段之后的静音秒数；不填用 channel/voice.json 的默认值", "type": "number", "minimum": 0, "maximum": 3 },
          "sentences": {
            "type": "array", "minItems": 1,
            "items": { "$ref": "#/$defs/sentence" }
          }
        }
      }
    },
    "sources": {
      "description": "事实出处；句子用 id 引用",
      "type": "array",
      "items": {
        "type": "object", "required": ["id", "url", "publisher"], "additionalProperties": false,
        "properties": {
          "id": { "type": "string", "pattern": "^src[0-9]{2,3}$" },
          "url": { "type": "string" },
          "publisher": { "type": "string" },
          "title": { "type": "string" },
          "date": { "type": "string" }
        }
      }
    }
  },
  "$defs": {
    "sentence": {
      "type": "object", "required": ["id", "text"], "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^s[0-9]{4}$" },
        "text": { "description": "配音原文，一字不差送进 TTS", "type": "string", "minLength": 1 },
        "kind": { "enum": ["narration", "quote", "hook", "cta"], "default": "narration" },
        "emphasis": {
          "description": "重点词：画面重音卡在这些词开口的时刻。text 必须在句子原文里逐字出现",
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "text", "type"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^e[0-9]+$" },
              "text": { "type": "string", "minLength": 1 },
              "type": { "enum": ["number", "person", "place", "org", "date", "quote", "term", "other"] }
            }
          }
        },
        "onscreen": {
          "description": "允许上屏的文字（数字、人名、引语、标题）。画面上的字只能引用这里，制作环节不许重新打字",
          "type": "array",
          "items": {
            "type": "object", "required": ["id", "text", "type"], "additionalProperties": false,
            "properties": {
              "id": { "type": "string", "pattern": "^o[0-9]+$" },
              "text": { "type": "string", "minLength": 1 },
              "type": { "enum": ["headline", "number", "name", "quote", "label", "date", "place"] },
              "attribution": { "description": "引语的说话人/数据的出处，显示用", "type": "string" }
            }
          }
        },
        "needs_image": { "type": "boolean", "default": false },
        "image_brief": { "description": "给找图环节的说明：要什么、不要什么", "type": "string" },
        "sources": { "type": "array", "items": { "type": "string", "pattern": "^src[0-9]{2,3}$" } }
      }
    }
  }
}
