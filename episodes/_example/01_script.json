            }
          ],
          "sources": [
            "src02"
          ]
        },
        {
          "id": "s0004",
          "kind": "quote",
          "text": "One baker told reporters, \"We are an island now.\"",
          "emphasis": [
            {
              "id": "e1",
              "text": "We are an island now.",
