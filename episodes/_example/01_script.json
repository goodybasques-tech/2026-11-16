              "id": "o1",
              "text": "40,000",
              "type": "number"
            },
            {
              "id": "o2",
              "text": "March 3",
              "type": "date"
            }
          ],
          "sources": [
            "src01"
          ]
        },
        {
          "id": "s0002",
          "text": "Inspectors had found cracked welds on the Harbor Bridge, and the state shut it overnight.",
          "emphasis": [
            {
              "id": "e1",
              "text": "cracked welds",
              "type": "term"
            }
          ],
          "onscreen": [
