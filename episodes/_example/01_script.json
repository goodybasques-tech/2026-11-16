          "id": "s0001",
          "kind": "hook",
          "text": "On March 3rd, a city of 40,000 people woke up cut in half.",
          "emphasis": [
            {
              "id": "e1",
              "text": "March 3rd",
              "type": "date"
            },
            {
              "id": "e2",
              "text": "40,000",
              "type": "number"
            }
          ],
          "onscreen": [
