    },
    {
      "id": "p002",
      "chapter": "c01",
      "sentences": [
        {
          "id": "s0003",
          "text": "Shop owners on the east bank say foot traffic dropped by a third in the first week.",
          "emphasis": [
            {
              "id": "e1",
              "text": "a third",
              "type": "number"
            }
          ],
